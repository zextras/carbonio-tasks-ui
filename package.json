{
	"name": "carbonio-tasks-ui",
	"version": "0.1.1",
	"description": "Tasks module",
	"main": "src/app.tsx",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": "v22",
		"pnpm": ">=10"
	},
	"scripts": {
		"bump-version": "semantic-release",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"build": "sdk build",
		"deploy": "sdk install",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"prepare": "is-ci || husky",
		"start": "sdk watch",
		"type-check": "tsc --noEmit",
		"type-check:watch": "pnpm run type-check -- --watch",
		"codegen": "NODE_TLS_REJECT_UNAUTHORIZED=0 graphql-codegen --config codegen.ts",
		"codegen:watch": "NODE_TLS_REJECT_UNAUTHORIZED=0 graphql-codegen --config codegen.ts --watch",
		"build:dev": "sdk build --dev --pkgRel $(date +%s)"
	},
	"keywords": [],
	"author": "",
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/preset-env": "7.29.7",
		"@babel/preset-react": "7.29.7",
		"@babel/preset-typescript": "7.29.7",
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@emotion/babel-plugin": "11.13.5",
		"@faker-js/faker": "10.4.0",
		"@graphql-codegen/add": "6.0.1",
		"@graphql-codegen/cli": "6.3.1",
		"@graphql-codegen/fragment-matcher": "6.0.1",
		"@graphql-codegen/schema-ast": "5.0.2",
		"@graphql-codegen/typed-document-node": "6.1.8",
		"@graphql-codegen/typescript": "5.0.10",
		"@graphql-codegen/typescript-operations": "5.1.0",
		"@graphql-eslint/eslint-plugin": "4.4.0",
		"@graphql-typed-document-node/core": "3.2.0",
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/git": "10.0.1",
		"@semantic-release/github": "12.0.8",
		"@semantic-release/npm": "13.1.5",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/lodash": "4.17.24",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "5.2.0",
		"@vitest/coverage-v8": "4.1.9",
		"@vitest/ui": "4.1.9",
		"@zextras/carbonio-ui-configs": "2.1.0",
		"@zextras/carbonio-ui-sdk": "2.3.6",
		"dotenv": "17.4.2",
		"eslint": "8.57.1",
		"eslint-plugin-notice": "1.0.0",
		"graphql-tag": "2.12.6",
		"history": "5.3.0",
		"husky": "9.1.7",
		"is-ci": "4.1.0",
		"jsdom": "29.1.1",
		"msw": "2.14.6",
		"semantic-release": "25.0.5",
		"sonarqube-scanner": "4.3.6",
		"ts-node": "10.9.2",
		"typescript": "5.9.3",
		"vitest": "4.1.9",
		"vitest-fail-on-console": "0.10.1"
	},
	"dependencies": {
		"@apollo/client": "4.2.2",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@zextras/carbonio-design-system": "12.0.4",
		"@zextras/carbonio-shell-ui": "15.1.0",
		"core-js": "3.49.0",
		"date-fns": "4.4.0",
		"graphql": "16.14.1",
		"i18next": "22.5.1",
		"lodash": "4.18.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-i18next": "12.3.1",
		"react-router-dom": "6.30.4",
		"rxjs": "7.8.2"
	},
	"browserslist": [
		">1%",
		"last 1 version",
		"Firefox ESR",
		"not dead"
	],
	"carbonio": {
		"name": "carbonio-tasks-ui",
		"priority": 10,
		"attrKey": "carbonioFeatureTasksEnabled",
		"type": "carbonio",
		"display": "Tasks",
		"icon": "CheckmarkCircle2Outline"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js",
			"esbuild",
			"msw",
			"protobufjs",
			"unrs-resolver"
		]
	}
}
